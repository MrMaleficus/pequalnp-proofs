import Mathlib
import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_1703

open PEqualNP.CircuitLowerBounds

theorem snoc_len (w : List Bool) (b : Bool) : (w ++ [b]).length = w.length + 1 := by
  simp

theorem snoc_last (w : List Bool) (b : Bool) (a : ℕ) (ha : a = w.length) :
    (w ++ [b]).getD a false = b := by
  subst ha
  simp [List.getD]

theorem snoc_ne (w : List Bool) (b : Bool) (a : ℕ) (ha : a ≠ w.length) :
    (w ++ [b]).getD a false = w.getD a false := by
  by_cases hlt : a < w.length
  · simp [List.getD, List.getElem?_append_left hlt]
  · rw [List.getD_eq_default _ _ (by rw [snoc_len]; omega),
      List.getD_eq_default _ _ (by omega)]

-- Tables are kept newest first: wire a of L wires sits at position L - 1 - a.
def look (L : ℕ) (acc : List ℕ) (a : ℕ) : ℕ :=
  if a < L then acc.getD (L - 1 - a) 0 else 0

theorem look_cons (L v : ℕ) (acc : List ℕ) (a : ℕ) :
    look (L + 1) (v :: acc) a = if a = L then v else look L acc a := by
  unfold look
  by_cases h1 : a = L
  · subst h1
    simp
  · by_cases h2 : a < L
    · have e : L + 1 - 1 - a = (L - 1 - a) + 1 := by omega
      have h3 : a < L + 1 := by omega
      rw [if_pos h3, if_neg h1, if_pos h2, e, List.getD_cons_succ]
    · have h3 : ¬ a < L + 1 := by omega
      rw [if_neg h3, if_neg h1, if_neg h2]

def gval (L : ℕ) (acc : List ℕ) (g : Gate) : ℕ :=
  match g.op, g.inputs with
  | GateOp.and, [a, b] => Nat.land (look L acc a) (look L acc b)
  | GateOp.or, [a, b] => Nat.lor (look L acc a) (look L acc b)
  | _, _ => 0

def ok2 (g : Gate) : Bool :=
  match g.op, g.inputs with
  | GateOp.and, [_, _] => true
  | GateOp.or, [_, _] => true
  | _, _ => false

theorem gval_spec (k L : ℕ) (acc : List ℕ) (w : List Bool) (g : Gate) (hok : ok2 g = true)
    (h : ∀ a, Nat.testBit (look L acc a) k = w.getD a false) :
    Nat.testBit (gval L acc g) k = g.op.eval (g.inputs.map fun i => w.getD i false) := by
  obtain ⟨op, inputs⟩ := g
  cases op with
  | and =>
    rcases inputs with _ | ⟨a, _ | ⟨b, _ | ⟨c, r⟩⟩⟩
    · exact absurd hok Bool.false_ne_true
    · exact absurd hok Bool.false_ne_true
    · show Nat.testBit (look L acc a &&& look L acc b) k = _
      rw [Nat.testBit_and, h a, h b]
      simp [GateOp.eval]
    · exact absurd hok Bool.false_ne_true
  | or =>
    rcases inputs with _ | ⟨a, _ | ⟨b, _ | ⟨c, r⟩⟩⟩
    · exact absurd hok Bool.false_ne_true
    · exact absurd hok Bool.false_ne_true
    · show Nat.testBit (look L acc a ||| look L acc b) k = _
      rw [Nat.testBit_or, h a, h b]
      simp [GateOp.eval]
    · exact absurd hok Bool.false_ne_true
  | not =>
    rcases inputs with _ | ⟨a, _ | ⟨b, _ | ⟨c, r⟩⟩⟩ <;> exact absurd hok Bool.false_ne_true
  | mod m =>
    rcases inputs with _ | ⟨a, _ | ⟨b, _ | ⟨c, r⟩⟩⟩ <;> exact absurd hok Bool.false_ne_true
  | maj =>
    rcases inputs with _ | ⟨a, _ | ⟨b, _ | ⟨c, r⟩⟩⟩ <;> exact absurd hok Bool.false_ne_true

-- The evaluator on tables. Each new table is forced to a numeral before going on.
def run : List Gate → ℕ → List ℕ → List ℕ
  | [], _, acc => acc
  | g :: gs, L, acc =>
    match gval L acc g, L + 1 with
    | 0, 0 => acc
    | 0, l + 1 => run gs (l + 1) (0 :: acc)
    | _ + 1, 0 => acc
    | n + 1, l + 1 => run gs (l + 1) ((n + 1) :: acc)

theorem run_cons (g : Gate) (gs : List Gate) (L : ℕ) (acc : List ℕ) :
    run (g :: gs) L acc = run gs (L + 1) (gval L acc g :: acc) := by
  rw [run]
  cases gval L acc g <;> rfl

def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

theorem run_sound (k : ℕ) : ∀ (gs : List Gate) (L : ℕ) (acc : List ℕ) (w : List Bool),
    (∀ g ∈ gs, ok2 g = true) → w.length = L →
    (∀ a, Nat.testBit (look L acc a) k = w.getD a false) →
    ∀ a, Nat.testBit (look (L + gs.length) (run gs L acc) a) k =
      (gs.foldl step w).getD a false := by
  intro gs
  induction gs with
  | nil =>
    intro L acc w _ _ h a
    exact h a
  | cons g gs ih =>
    intro L acc w hok hlen h a
    have e : L + (g :: gs).length = L + 1 + gs.length := by
      simp only [List.length_cons]
      omega
    rw [e, run_cons, List.foldl_cons]
    refine ih (L + 1) (gval L acc g :: acc) (step w g)
      (fun g' hg' => hok g' (List.mem_cons.mpr (Or.inr hg'))) ?_ ?_ a
    · show (w ++ [_]).length = L + 1
      rw [snoc_len, hlen]
    · intro a'
      rw [look_cons]
      by_cases h1 : a' = L
      · rw [if_pos h1, gval_spec k L acc w g (hok g (List.mem_cons.mpr (Or.inl rfl))) h]
        exact (snoc_last w _ a' (by rw [hlen]; exact h1)).symm
      · rw [if_neg h1, h a']
        exact (snoc_ne w _ a' (by rw [hlen]; exact h1)).symm

-- Input number k < 147 * 147 stands for the input whose on wires are k / 147 and k % 147
-- (the value 146 standing for no wire).
def bitT (a k : ℕ) : Bool := decide (k / 147 = a) || decide (k % 147 = a)

def rowT (a : ℕ) : ℕ := (2 ^ 147 - 1) <<< (147 * a)

def colT : ℕ → ℕ
  | 0 => 0
  | m + 1 => Nat.lor ((colT m) <<< 147) (2 ^ 0)

def rep : ℕ := (2 ^ (147 * 147) - 1) / (2 ^ 147 - 1)

def tabT (a : ℕ) : ℕ := Nat.lor (rowT a) (rep <<< a)

theorem rowT_bit (a k : ℕ) : Nat.testBit (rowT a) k = decide (k / 147 = a) := by
  unfold rowT
  rw [Nat.testBit_shiftLeft, Nat.testBit_two_pow_sub_one, Bool.eq_iff_iff]
  simp only [Bool.and_eq_true, decide_eq_true_eq]
  omega

theorem colT_bit : ∀ m k : ℕ,
    Nat.testBit (colT m) k = decide (k < 147 * m ∧ k % 147 = 0) := by
  intro m
  induction m with
  | zero =>
    intro k
    show Nat.testBit 0 k = _
    rw [Nat.zero_testBit]
    simp
  | succ m ih =>
    intro k
    show Nat.testBit ((colT m) <<< 147 ||| 2 ^ 0) k = _
    rw [Nat.testBit_or, Nat.testBit_shiftLeft, ih, Nat.testBit_two_pow, Bool.eq_iff_iff]
    simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq]
    omega

theorem rep_eq : rep = colT 147 := by decide +kernel

theorem tabT_bit (a k : ℕ) (ha : a < 147) (hk : k < 147 * 147) :
    Nat.testBit (tabT a) k = bitT a k := by
  show Nat.testBit (rowT a ||| rep <<< a) k = (decide (k / 147 = a) || decide (k % 147 = a))
  rw [Nat.testBit_or, rowT_bit, Nat.testBit_shiftLeft, rep_eq, colT_bit, Bool.eq_iff_iff]
  simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq]
  omega

def initAcc : ℕ → List ℕ
  | 0 => []
  | m + 1 => tabT m :: initAcc m

theorem init_bit (k : ℕ) (hk : k < 147 * 147) : ∀ m : ℕ, m ≤ 147 → ∀ a : ℕ,
    Nat.testBit (look m (initAcc m) a) k = (decide (a < m) && bitT a k) := by
  intro m
  induction m with
  | zero =>
    intro _ a
    show Nat.testBit (look 0 [] a) k = _
    simp [look]
  | succ m ih =>
    intro hm a
    show Nat.testBit (look (m + 1) (tabT m :: initAcc m) a) k = _
    rw [look_cons]
    by_cases h1 : a = m
    · subst h1
      rw [if_pos rfl, tabT_bit a k (by omega) hk]
      simp
    · rw [if_neg h1, ih (by omega) a]
      have e : decide (a < m + 1) = decide (a < m) := by
        simp only [decide_eq_decide]
        omega
      rw [e]

-- Builds the 146 input tables (each forced to a numeral), then runs the gates.
def start (gs : List Gate) : ℕ → List ℕ → List ℕ
  | 0, acc => run gs 146 acc
  | f + 1, acc =>
    match tabT (145 - f) with
    | 0 => start gs f (0 :: acc)
    | n + 1 => start gs f ((n + 1) :: acc)

theorem start_succ (gs : List Gate) (f : ℕ) (acc : List ℕ) :
    start gs (f + 1) acc = start gs f (tabT (145 - f) :: acc) := by
  rw [start]
  cases tabT (145 - f) <;> rfl

theorem start_gen (gs : List Gate) : ∀ f : ℕ, f ≤ 146 →
    start gs f (initAcc (146 - f)) = run gs 146 (initAcc 146) := by
  intro f
  induction f with
  | zero =>
    intro _
    rfl
  | succ f ih =>
    intro hf
    have e1 : 146 - (f + 1) = 145 - f := by omega
    have e2 : 146 - f = (145 - f) + 1 := by omega
    rw [start_succ, e1, ← ih (by omega), e2]
    rfl

theorem start_eq (gs : List Gate) : start gs 146 [] = run gs 146 (initAcc 146) :=
  start_gen gs 146 (le_refl 146)

-- The table of the incidence function, built from the list of incident pairs.
def specRun : List (ℕ × ℕ) → ℕ → ℕ
  | [], s => s
  | pl :: r, s =>
    match Nat.lor s (Nat.land (tabT pl.1) (tabT (73 + pl.2))) with
    | 0 => specRun r 0
    | n + 1 => specRun r (n + 1)

theorem specRun_cons (pl : ℕ × ℕ) (r : List (ℕ × ℕ)) (s : ℕ) :
    specRun (pl :: r) s = specRun r (Nat.lor s (Nat.land (tabT pl.1) (tabT (73 + pl.2)))) := by
  rw [specRun]
  cases Nat.lor s (Nat.land (tabT pl.1) (tabT (73 + pl.2))) <;> rfl

theorem spec_bit (k : ℕ) (hk : k < 147 * 147) : ∀ (l : List (ℕ × ℕ)) (s : ℕ),
    (∀ pl ∈ l, pl.1 < 73 ∧ pl.2 < 73) →
    Nat.testBit (specRun l s) k =
      (Nat.testBit s k || l.any (fun pl => bitT pl.1 k && bitT (73 + pl.2) k)) := by
  intro l
  induction l with
  | nil =>
    intro s _
    show Nat.testBit s k = _
    simp
  | cons pl r ih =>
    intro s hb
    obtain ⟨h1, h2⟩ := hb pl (List.mem_cons.mpr (Or.inl rfl))
    rw [specRun_cons, ih _ (fun q hq => hb q (List.mem_cons.mpr (Or.inr hq)))]
    show (Nat.testBit (s ||| (tabT pl.1 &&& tabT (73 + pl.2))) k || _) = _
    rw [Nat.testBit_or, Nat.testBit_and, tabT_bit pl.1 k (by omega) hk,
      tabT_bit (73 + pl.2) k (by omega) hk, List.any_cons, Bool.or_assoc]

-- A set of at most two wires is described by two numbers (146 standing for no wire).
theorem two_set (S : Finset ℕ) (hc : S.card ≤ 2) (hb : ∀ n ∈ S, n < 146) :
    ∃ i j : ℕ, i < 147 ∧ j < 147 ∧ ∀ n : ℕ, n < 146 → (n ∈ S ↔ (i = n ∨ j = n)) := by
  have h3 : S.card = 0 ∨ S.card = 1 ∨ S.card = 2 := by omega
  rcases h3 with h0 | h1 | h2
  · rw [Finset.card_eq_zero] at h0
    subst h0
    refine ⟨146, 146, by omega, by omega, fun n hn => ?_⟩
    constructor
    · intro h
      simp at h
    · intro h
      omega
  · obtain ⟨a, rfl⟩ := Finset.card_eq_one.mp h1
    have ha : a < 146 := hb a (Finset.mem_singleton_self a)
    refine ⟨a, a, by omega, by omega, fun n hn => ?_⟩
    rw [Finset.mem_singleton]
    omega
  · obtain ⟨a, b, hab, rfl⟩ := Finset.card_eq_two.mp h2
    have ha : a < 146 := hb a (by simp)
    have hb2 : b < 146 := hb b (by simp)
    refine ⟨a, b, by omega, by omega, fun n hn => ?_⟩
    rw [Finset.mem_insert, Finset.mem_singleton]
    omega

theorem pick (x y : Fin 73 → Bool)
    (h : (Finset.univ.filter (fun p : Fin 73 => x p = true)).card +
      (Finset.univ.filter (fun l : Fin 73 => y l = true)).card ≤ 2) :
    ∃ i j : ℕ, i < 147 ∧ j < 147 ∧
      (∀ p : Fin 73, x p = (decide (i = (p : ℕ)) || decide (j = (p : ℕ)))) ∧
      (∀ l : Fin 73, y l = (decide (i = 73 + (l : ℕ)) || decide (j = 73 + (l : ℕ)))) := by
  obtain ⟨S, hS⟩ : ∃ S : Finset ℕ, S =
      (Finset.univ.filter (fun p : Fin 73 => x p = true)).image (fun p : Fin 73 => (p : ℕ)) ∪
      (Finset.univ.filter (fun l : Fin 73 => y l = true)).image (fun l : Fin 73 => 73 + (l : ℕ)) :=
    ⟨_, rfl⟩
  have hmem : ∀ n, n ∈ S ↔ (∃ p : Fin 73, x p = true ∧ (p : ℕ) = n) ∨
      (∃ l : Fin 73, y l = true ∧ 73 + (l : ℕ) = n) := by
    intro n
    rw [hS]
    simp [Finset.mem_union, Finset.mem_image]
  have hc : S.card ≤ 2 := by
    rw [hS]
    exact le_trans (Finset.card_union_le _ _)
      (le_trans (Nat.add_le_add Finset.card_image_le Finset.card_image_le) h)
  have hb : ∀ n ∈ S, n < 146 := by
    intro n hn
    rcases (hmem n).mp hn with ⟨p, _, rfl⟩ | ⟨l, _, rfl⟩
    · have := p.isLt
      omega
    · have := l.isLt
      omega
  obtain ⟨i, j, hi, hj, hij⟩ := two_set S hc hb
  refine ⟨i, j, hi, hj, fun p => ?_, fun l => ?_⟩
  · have hp := p.isLt
    rw [Bool.eq_iff_iff, Bool.or_eq_true, decide_eq_true_eq, decide_eq_true_eq,
      ← hij (p : ℕ) (by omega), hmem]
    constructor
    · intro hx
      exact Or.inl ⟨p, hx, rfl⟩
    · rintro (⟨p', hx', he⟩ | ⟨l', _, he⟩)
      · have e : p' = p := Fin.ext he
        rw [← e]
        exact hx'
      · have := l'.isLt
        omega
  · have hl := l.isLt
    rw [Bool.eq_iff_iff, Bool.or_eq_true, decide_eq_true_eq, decide_eq_true_eq,
      ← hij (73 + (l : ℕ)) (by omega), hmem]
    constructor
    · intro hy
      exact Or.inr ⟨l, hy, rfl⟩
    · rintro (⟨p', _, he⟩ | ⟨l', hy', he⟩)
      · have := p'.isLt
        omega
      · have e : l' = l := Fin.ext (by omega)
        rw [← e]
        exact hy'

theorem getD_ofFn (f : Fin 73 → Bool) (a : ℕ) (h : a < 73) :
    (List.ofFn f).getD a false = f ⟨a, h⟩ := by
  rw [List.getD_eq_getElem _ _ (by rw [List.length_ofFn]; exact h), List.getElem_ofFn]

theorem getD_x (x y : Fin 73 → Bool) (a : ℕ) (h : a < 73) :
    (List.ofFn x ++ List.ofFn y).getD a false = x ⟨a, h⟩ := by
  rw [List.getD_append _ _ _ _ (by rw [List.length_ofFn]; exact h), getD_ofFn x a h]

theorem getD_y (x y : Fin 73 → Bool) (a : ℕ) (h1 : 73 ≤ a) (h : a - 73 < 73) :
    (List.ofFn x ++ List.ofFn y).getD a false = y ⟨a - 73, h⟩ := by
  rw [List.getD_append_right _ _ _ _ (by rw [List.length_ofFn]; exact h1), List.length_ofFn,
    getD_ofFn y (a - 73) h]

