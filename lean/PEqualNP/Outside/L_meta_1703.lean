    circ.eval w = inc.any (fun pl => bitT pl.1 k && bitT (73 + pl.2) k) := by
  have h0 : ∀ a, Nat.testBit (look 146 (initAcc 146) a) k = w.getD a false := by
    intro a
    rw [init_bit k hk 146 (by omega) a]
    by_cases ha : a < 146
    · rw [hw a ha]
      simp [ha]
    · rw [List.getD_eq_default _ _ (by omega)]
      simp [ha]
  have h1 := run_sound k gl 146 (initAcc 146) w gl_ok hlen h0 856
  rw [gl_len] at h1
  have h2 := spec_bit k hk inc 0 inc_bound
  rw [Nat.zero_testBit, Bool.false_or] at h2
  have h3 : look (146 + 711) (run gl 146 (initAcc 146)) 856 = specRun inc 0 := by
    rw [← start_eq]
    exact table_eq
  rw [h3] at h1
  show (gl.foldl step w).getD 856 false = _
  rw [← h1, h2]

theorem main_core (x y : Fin 73 → Bool)
    (h : (Finset.univ.filter (fun p : Fin 73 => x p = true)).card +
      (Finset.univ.filter (fun l : Fin 73 => y l = true)).card ≤ 2) :
    circ.eval (List.ofFn x ++ List.ofFn y) =
      decide (∃ p : Fin 73, ∃ l : Fin 73, ((p : ℕ), (l : ℕ)) ∈ inc ∧ x p = true ∧ y l = true) := by
  obtain ⟨i, j, hi, hj, hx, hy⟩ := pick x y h
  have hk : 147 * i + j < 147 * 147 := by omega
  have hd : (147 * i + j) / 147 = i := by omega
  have hm : (147 * i + j) % 147 = j := by omega
  have hb : ∀ a, bitT a (147 * i + j) = (decide (i = a) || decide (j = a)) := by
    intro a
    unfold bitT
    rw [hd, hm]
  have hw : ∀ a, a < 146 →
      (List.ofFn x ++ List.ofFn y).getD a false = bitT a (147 * i + j) := by
    intro a ha
    rw [hb]
    by_cases h73 : a < 73
    · rw [getD_x x y a h73]
      exact hx ⟨a, h73⟩
    · have h1 : 73 ≤ a := by omega
      have h2 : a - 73 < 73 := by omega
      have e : 73 + (a - 73) = a := by omega
      have hy2 : y ⟨a - 73, h2⟩ =
          (decide (i = 73 + (a - 73)) || decide (j = 73 + (a - 73))) := hy ⟨a - 73, h2⟩
      rw [e] at hy2
      rw [getD_y x y a h1 h2]
      exact hy2
  have hlen : (List.ofFn x ++ List.ofFn y).length = 146 := by
    rw [List.length_append, List.length_ofFn, List.length_ofFn]
  rw [eval_bit (147 * i + j) hk (List.ofFn x ++ List.ofFn y) hlen hw, Bool.eq_iff_iff,
    List.any_eq_true, decide_eq_true_eq]
  constructor
  · rintro ⟨pl, hmem, hpl⟩
    obtain ⟨h1, h2⟩ := inc_bound pl hmem
    have hpl2 : (bitT pl.1 (147 * i + j) && bitT (73 + pl.2) (147 * i + j)) = true := hpl
    rw [Bool.and_eq_true, hb, hb] at hpl2
    refine ⟨⟨pl.1, h1⟩, ⟨pl.2, h2⟩, hmem, ?_, ?_⟩
    · rw [hx]
      exact hpl2.1
    · rw [hy]
      exact hpl2.2
  · rintro ⟨p, l, hmem, hxp, hyl⟩
    refine ⟨((p : ℕ), (l : ℕ)), hmem, ?_⟩
    show (bitT (p : ℕ) (147 * i + j) && bitT (73 + (l : ℕ)) (147 * i + j)) = true
    rw [Bool.and_eq_true, hb, hb, ← hx, ← hy]
    exact ⟨hxp, hyl⟩

