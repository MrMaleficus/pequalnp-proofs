-- Use: induction on the wire index w (Nat.strong_induction_on) with val_input / val_ge / val_gate to compare two runs.

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.MetaComplexity.NestedCover

def val (C : Circuit) (x : List Bool) (u : ℕ) : Bool := (C.wires x).getD u false

theorem eval_eq_val (C : Circuit) (x : List Bool) : C.eval x = val C x C.output := rfl

theorem circuitFun_val (n : ℕ) (C : Circuit) (x : Fin n → Bool) :
    circuitFun n C x = val C (List.ofFn x) C.output := rfl

theorem val_input {n : ℕ} {C : Circuit} {x : List Bool} (hx : x.length = n) {u : ℕ} (hu : u < n) :
    val C x u = x.getD u false := W_prefix _ _ _ (by omega)

theorem val_ge {n : ℕ} {C : Circuit} {x : List Bool} (hx : x.length = n) {u : ℕ}
    (hu : n + C.gates.length ≤ u) : val C x u = false := W_ge _ _ _ (by omega)

theorem val_gate {n : ℕ} {C : Circuit} {x : List Bool} (hx : x.length = n) {j : ℕ}
    (hj : j < C.gates.length) :
    val C x (n + j) = (gateAt C j).op.eval ((gateAt C j).inputs.map fun i =>
      if i < n + j then val C x i else false) := by
  subst hx
  rw [gateAt_eq hj]
  exact W_gate C.gates x j hj

theorem val_gate_rb {n : ℕ} {C : Circuit} {x : List Bool} (hx : x.length = n) {j : ℕ}
    (hj : j < C.gates.length) (hrb : ∀ i ∈ (gateAt C j).inputs, i < n + j) :
    val C x (n + j) = (gateAt C j).op.eval ((gateAt C j).inputs.map fun i => val C x i) := by
  rw [val_gate hx hj]
  congr 1
  apply List.map_congr_left
  intro i hi
  rw [if_pos (hrb i hi)]

theorem val_ofFn {n : ℕ} (C : Circuit) (x : Fin n → Bool) (u : Fin n) :
    val C (List.ofFn x) u.val = x u := by
  rw [val_input (n := n) (by simp) u.isLt]
  simp [List.getD_eq_getElem?_getD]

theorem val_ofFn_lt {n : ℕ} (C : Circuit) (x : Fin n → Bool) (u : ℕ) (hu : u < n) :
    val C (List.ofFn x) u = x ⟨u, hu⟩ := val_ofFn C x ⟨u, hu⟩

def OpMono (R : Bool → Bool → Prop) : Prop :=
  ∀ (op : GateOp), (op = GateOp.and ∨ op = GateOp.or) → ∀ (l : List ℕ) (f g : ℕ → Bool),
    (∀ i ∈ l, R (f i) (g i)) → R (op.eval (l.map f)) (op.eval (l.map g))

theorem opMono_eq : OpMono Eq := by
  intro op _ l f g h
  rw [List.map_congr_left h]

theorem opMono_imp : OpMono (fun a b => a = true → b = true) := by
  intro op hop l f g h
  rcases hop with rfl | rfl
  · simp only [GateOp.eval, List.all_map, List.all_eq_true, Function.comp_apply, id_eq]
    intro h1 i hi; exact h i hi (h1 i hi)
  · simp only [GateOp.eval, List.any_map, List.any_eq_true, Function.comp_apply, id_eq]
    rintro ⟨i, hi, h1⟩; exact ⟨i, hi, h i hi h1⟩

theorem val_or {n : ℕ} {C : Circuit} {x : List Bool} (hx : x.length = n) {r : ℕ}
    (hr : r < C.gates.length) (hop : (gateAt C r).op = GateOp.or) :
    val C x (n + r) = true ↔ ∃ i ∈ (gateAt C r).inputs, i < n + r ∧ val C x i = true := by
  rw [val_gate hx hr, hop]
  simp only [GateOp.eval, List.any_map, List.any_eq_true, Function.comp_apply, id_eq]
  constructor
  · rintro ⟨i, hi, h⟩
    by_cases hlt : i < n + r
    · rw [if_pos hlt] at h; exact ⟨i, hi, hlt, h⟩
    · rw [if_neg hlt] at h; cases h
  · rintro ⟨i, hi, hlt, h⟩
    exact ⟨i, hi, by rw [if_pos hlt]; exact h⟩

theorem val_and {n : ℕ} {C : Circuit} {x : List Bool} (hx : x.length = n) {r : ℕ}
    (hr : r < C.gates.length) (hop : (gateAt C r).op = GateOp.and) :
    val C x (n + r) = true ↔ ∀ i ∈ (gateAt C r).inputs, i < n + r ∧ val C x i = true := by
  rw [val_gate hx hr, hop]
  simp only [GateOp.eval, List.all_map, List.all_eq_true, Function.comp_apply, id_eq]
  constructor
  · intro h i hi
    have h' := h i hi
    by_cases hlt : i < n + r
    · rw [if_pos hlt] at h'; exact ⟨hlt, h'⟩
    · rw [if_neg hlt] at h'; cases h'
  · intro h i hi
    rw [if_pos (h i hi).1]; exact (h i hi).2

theorem andOrOnly_of_monotone2 {C : Circuit} (h : Monotone2 C) :
    PEqualNP.EdgeOwnership.AndOrOnly C := by
  intro g hg
  have h1 := (h g hg).1
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at h1
  exact h1

theorem andOrOnly_of_isAO2 {n : ℕ} {C : Circuit} (h : PEqualNP.TopForm.IsAO2 n C) :
    PEqualNP.EdgeOwnership.AndOrOnly C := h.1

theorem monotone2_len {C : Circuit} (h : Monotone2 C) {g : Gate} (hg : g ∈ C.gates) :
    g.inputs.length ≤ 2 := (h g hg).2

theorem isAO2_len {n : ℕ} {C : Circuit} (h : PEqualNP.TopForm.IsAO2 n C) {g : Gate} (hg : g ∈ C.gates) :
    g.inputs.length = 2 := h.2.2 g hg

theorem isAO2_rb {n : ℕ} {C : Circuit} (h : PEqualNP.TopForm.IsAO2 n C) {j : ℕ}
    (hj : j < C.gates.length) {i : ℕ} (hi : i ∈ (gateAt C j).inputs) : i < n + j :=
  h.2.1 j hj i hi

theorem mono (n : ℕ) (C : Circuit) (hAO : PEqualNP.EdgeOwnership.AndOrOnly C)
    (x y : Fin n → Bool) (hxy : ∀ i : Fin n, x i = true → y i = true) :
    ∀ w : ℕ, val C (List.ofFn x) w = true → val C (List.ofFn y) w = true := by
  intro w
  induction w using Nat.strong_induction_on with
  | _ w ih =>
    intro hv
    by_cases hw : w < n
    · have e1 : val C (List.ofFn x) w = x ⟨w, hw⟩ := val_ofFn C x ⟨w, hw⟩
      have e2 : val C (List.ofFn y) w = y ⟨w, hw⟩ := val_ofFn C y ⟨w, hw⟩
      rw [e2]
      rw [e1] at hv
      exact hxy _ hv
    · by_cases hlen : n + C.gates.length ≤ w
      · rw [val_ge (n := n) (by simp) hlen] at hv
        cases hv
      · obtain ⟨k, rfl⟩ : ∃ k, w = n + k := ⟨w - n, by omega⟩
        have hk : k < C.gates.length := by omega
        rw [val_gate (n := n) (by simp) hk] at hv ⊢
        have h : ∀ i ∈ (gateAt C k).inputs,
            ((if i < n + k then val C (List.ofFn x) i else false) = true →
              (if i < n + k then val C (List.ofFn y) i else false) = true) := by
          intro i _
          by_cases hi : i < n + k
          · rw [if_pos hi, if_pos hi]
            exact ih i hi
          · rw [if_neg hi, if_neg hi]
            exact id
        exact opMono_imp (gateAt C k).op (hAO _ (gateAt_mem hk)) (gateAt C k).inputs
          (fun i => if i < n + k then val C (List.ofFn x) i else false)
          (fun i => if i < n + k then val C (List.ofFn y) i else false) h hv

theorem circuitFun_mono (n : ℕ) (C : Circuit) (hAO : PEqualNP.EdgeOwnership.AndOrOnly C)
    (x y : Fin n → Bool) (hxy : ∀ i : Fin n, x i = true → y i = true)
    (h : circuitFun n C x = true) : circuitFun n C y = true :=
  mono n C hAO x y hxy C.output h

theorem and_val (n : ℕ) (C : Circuit) (hC : PEqualNP.TopForm.IsAO2 n C) (x : List Bool)
    (hx : x.length = n) (j : ℕ) (hj : j < C.gates.length)
    (hop : (gateAt C j).op = GateOp.and) :
    val C x (n + j) = (val C x ((gateAt C j).inputs.getD 0 0) &&
      val C x ((gateAt C j).inputs.getD 1 0)) := by
  obtain ⟨_, hRB, h2⟩ := hC
  have hlen : (gateAt C j).inputs.length = 2 := h2 _ (gateAt_mem hj)
  have hrb : ∀ i ∈ (gateAt C j).inputs, i < n + j := hRB j hj
  obtain ⟨a, b, hab⟩ := List.length_eq_two.mp hlen
  rw [val_gate hx hj, hop]
  rw [hab] at hrb ⊢
  have ha : a < n + j := hrb a (by simp)
  have hb : b < n + j := hrb b (by simp)
  simp [GateOp.eval, ha, hb]

theorem or_val (n : ℕ) (C : Circuit) (hC : PEqualNP.TopForm.IsAO2 n C) (x : List Bool)
    (hx : x.length = n) (j : ℕ) (hj : j < C.gates.length)
    (hop : (gateAt C j).op = GateOp.or) :
    val C x (n + j) = (val C x ((gateAt C j).inputs.getD 0 0) ||
      val C x ((gateAt C j).inputs.getD 1 0)) := by
  obtain ⟨_, hRB, h2⟩ := hC
  have hlen : (gateAt C j).inputs.length = 2 := h2 _ (gateAt_mem hj)
  have hrb : ∀ i ∈ (gateAt C j).inputs, i < n + j := hRB j hj
  obtain ⟨a, b, hab⟩ := List.length_eq_two.mp hlen
  rw [val_gate hx hj, hop]
  rw [hab] at hrb ⊢
  have ha : a < n + j := hrb a (by simp)
  have hb : b < n + j := hrb b (by simp)
  simp [GateOp.eval, ha, hb]

def tr {n : ℕ} (y : Fin n → Bool) : Finset (Fin n) := Finset.univ.filter (fun i => y i = true)

theorem tr_lt {n : ℕ} (z y : Fin n → Bool) (hzy : ∀ i, z i = true → y i = true) (hne : z ≠ y) :
    (tr z).card < (tr y).card := by
  apply Finset.card_lt_card
  rw [Finset.ssubset_iff_subset_ne]
  refine ⟨?_, ?_⟩
  · intro i hi
    simp only [tr, Finset.mem_filter, Finset.mem_univ, true_and] at hi ⊢
    exact hzy i hi
  · intro heq
    apply hne
    funext i
    have h : i ∈ tr z ↔ i ∈ tr y := by rw [heq]
    simp only [tr, Finset.mem_filter, Finset.mem_univ, true_and] at h
    exact Bool.eq_iff_iff.mpr h

theorem exists_min {n : ℕ} (F : (Fin n → Bool) → Bool) (x : Fin n → Bool) (hx : F x = true) :
    ∃ y : Fin n → Bool, (∀ i, y i = true → x i = true) ∧ F y = true ∧
      ∀ z : Fin n → Bool, (∀ i, z i = true → y i = true) → z ≠ y → F z = false := by
  let S : Finset (Fin n → Bool) :=
    Finset.univ.filter (fun y => F y = true ∧ ∀ i, y i = true → x i = true)
  have hS : S.Nonempty := ⟨x, by simp [S, hx]⟩
  obtain ⟨y, hyS, hmin⟩ := Finset.exists_min_image S (fun y => (tr y).card) hS
  simp only [S, Finset.mem_filter, Finset.mem_univ, true_and] at hyS
  refine ⟨y, hyS.2, hyS.1, ?_⟩
  intro z hzy hne
  cases hz : F z
  · rfl
  · exfalso
    have hzS : z ∈ S := by
      simp only [S, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨hz, fun i hi => hyS.2 i (hzy i hi)⟩
    have h1 := hmin z hzS
    have h2 := tr_lt z y hzy hne
    omega

theorem c99_gF {n : ℕ} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] (x : Fin n → Bool) :
    graphFun G ∅ x = true ↔ ∃ u v, G.Adj u v ∧ x u = true ∧ x v = true := by
  simp [graphFun]

def c99gs (X : ℕ) : ℕ → List Gate → List Gate
  | _, [] => []
  | b, g :: gs => (if b = X then (⟨GateOp.or, []⟩ : Gate) else ⟨GateOp.or, g.inputs⟩) :: c99gs X (b + 1) gs

theorem c99_len (X : ℕ) (gs : List Gate) : ∀ b, (c99gs X b gs).length = gs.length := by
  induction gs with
  | nil => intro b; rfl
  | cons g gs ih =>
    intro b
    show (c99gs X (b + 1) gs).length + 1 = gs.length + 1
    rw [ih]

theorem c99_getD (X : ℕ) (gs : List Gate) : ∀ b j, (c99gs X b gs).getD j ⟨GateOp.or, []⟩ =
    if b + j = X then (⟨GateOp.or, []⟩ : Gate) else ⟨GateOp.or, (gs.getD j ⟨GateOp.or, []⟩).inputs⟩ := by
  induction gs with
  | nil =>
    intro b j
    split_ifs <;> simp [c99gs]
  | cons g gs ih =>
    intro b j
    cases j with
    | zero => simp [c99gs]
    | succ j =>
      show (c99gs X (b + 1) gs).getD j _ = _
      rw [ih (b + 1) j, show b + 1 + j = b + (j + 1) by omega]
      simp

theorem c99_fold (X : ℕ) (gs : List Gate) : ∀ d : List Bool,
    gs.foldl (fun (d : List Bool) (g : Gate) => d ++ [decide (d.length ≠ X) && g.inputs.any fun i => d.getD i false]) d
      = W (c99gs X d.length gs) d := by
  induction gs with
  | nil => intro d; rfl
  | cons g gs ih =>
    intro d
    rw [List.foldl_cons, ih]
    have e2 : step d (if d.length = X then (⟨GateOp.or, []⟩ : Gate) else ⟨GateOp.or, g.inputs⟩) =
        d ++ [decide (d.length ≠ X) && g.inputs.any fun i => d.getD i false] := by
      by_cases h : d.length = X
      · rw [if_pos h]
        simp [step, h, GateOp.eval]
      · rw [if_neg h]
        simp [step, h, GateOp.eval, List.any_map]
    show _ = W (c99gs X (d.length + 1) gs) (step d _)
    rw [e2, List.length_append, List.length_singleton]

theorem c99_key (n : ℕ) (C : Circuit) (X : ℕ) (a : Fin n) (x y : Fin n → Bool) (hRB : ReadsBack n C)
    (hxy : ∀ i, i ≠ a → x i = y i) (hX : val C (List.ofFn x) X = val C (List.ofFn y) X) :
    ∀ w, val (⟨c99gs X n C.gates, C.output⟩ : Circuit)
      (List.ofFn (fun i : Fin n => decide (i = a ∧ i.val ≠ X))) w = false →
      val C (List.ofFn x) w = val C (List.ofFn y) w := by
  intro w
  induction w using Nat.strong_induction_on with
  | _ w ih =>
    intro hw
    by_cases hwX : w = X
    · subst hwX
      exact hX
    by_cases hwn : w < n
    · rw [val_ofFn_lt C x w hwn, val_ofFn_lt C y w hwn]
      apply hxy
      intro ha
      rw [val_ofFn_lt _ _ w hwn] at hw
      have h2 : decide ((⟨w, hwn⟩ : Fin n) = a ∧ w ≠ X) = false := hw
      rw [ha] at h2
      simp [hwX] at h2
    by_cases hwl : w < n + C.gates.length
    · obtain ⟨j, rfl⟩ : ∃ j, w = n + j := ⟨w - n, by omega⟩
      have hj : j < C.gates.length := by omega
      have hrb := hRB j hj
      have hlen : (c99gs X n C.gates).length = C.gates.length := c99_len X C.gates n
      have hg' : gateAt (⟨c99gs X n C.gates, C.output⟩ : Circuit) j = ⟨GateOp.or, (gateAt C j).inputs⟩ := by
        show (c99gs X n C.gates).getD j _ = _
        rw [c99_getD, if_neg hwX]
        rfl
      have hx0 : (List.ofFn (fun i : Fin n => decide (i = a ∧ i.val ≠ X))).length = n := by simp
      rw [val_gate (C := (⟨c99gs X n C.gates, C.output⟩ : Circuit)) hx0 (by exact hlen ▸ hj), hg'] at hw
      have hw' : GateOp.or.eval ((gateAt C j).inputs.map fun i => if i < n + j then
          val (⟨c99gs X n C.gates, C.output⟩ : Circuit)
            (List.ofFn (fun i : Fin n => decide (i = a ∧ i.val ≠ X))) i else false) = false := hw
      have hall : ∀ i ∈ (gateAt C j).inputs, val (⟨c99gs X n C.gates, C.output⟩ : Circuit)
          (List.ofFn (fun i : Fin n => decide (i = a ∧ i.val ≠ X))) i = false := by
        intro i hi
        cases h : val (⟨c99gs X n C.gates, C.output⟩ : Circuit)
          (List.ofFn (fun i : Fin n => decide (i = a ∧ i.val ≠ X))) i
        · rfl
        · exfalso
          have h3 := (eval_or_iff (gateAt C j).inputs (fun i => if i < n + j then
            val (⟨c99gs X n C.gates, C.output⟩ : Circuit)
              (List.ofFn (fun i : Fin n => decide (i = a ∧ i.val ≠ X))) i else false)).mpr
            ⟨i, hi, by show (if i < n + j then _ else false) = true; rw [if_pos (hrb i hi), h]⟩
          rw [h3] at hw'
          cases hw'
      rw [val_gate_rb (n := n) (by simp) hj hrb, val_gate_rb (n := n) (by simp) hj hrb]
      congr 1
      apply List.map_congr_left
      intro i hi
      exact ih i (hrb i hi) (hall i hi)
    · rw [val_ge (n := n) (by simp) (by omega), val_ge (n := n) (by simp) (by omega)]

theorem main_aux : ∀ (n : ℕ) (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] (C : PEqualNP.CircuitLowerBounds.Circuit) (a c : Fin n) (X : ℕ), PEqualNP.ReadK.AndOrFanInTwo C → PEqualNP.MetaComplexity.NestedCover.ReadsBack n C → PEqualNP.MetaComplexity.circuitFun n C = PEqualNP.MetaComplexity.NestedCover.graphFun G ∅ → G.Adj a c → (C.gates.foldl (fun (d : List Bool) (g : PEqualNP.CircuitLowerBounds.Gate) => d ++ [decide (d.length ≠ X) && g.inputs.any fun i => d.getD i false]) (List.ofFn fun i : Fin n => decide (i = a ∧ i.val ≠ X))).getD C.output false = false → ∀ J : Finset (Fin n), (∀ u ∈ J, ∀ v ∈ J, ¬ G.Adj u v) → c ∈ J → PEqualNP.CleanedNonEdge.wireVal n C X (PEqualNP.ReadK.setInput J) = false ∧ PEqualNP.CleanedNonEdge.wireVal n C X (PEqualNP.ReadK.setInput (insert a J)) = true := by
  intro n G hG C a c X hAF hRB hfun hac hfold J hJ hcJ
  have hxy : ∀ i, i ≠ a → PEqualNP.ReadK.setInput J i = PEqualNP.ReadK.setInput (insert a J) i := by
    intro i hi
    simp [PEqualNP.ReadK.setInput, Finset.mem_insert, hi]
  have hle : ∀ i, PEqualNP.ReadK.setInput J i = true → PEqualNP.ReadK.setInput (insert a J) i = true := by
    intro i h
    simp only [PEqualNP.ReadK.setInput, decide_eq_true_eq] at h ⊢
    exact Finset.mem_insert_of_mem h
  have hFx : graphFun G ∅ (PEqualNP.ReadK.setInput J) = false := by
    cases h : graphFun G ∅ (PEqualNP.ReadK.setInput J)
    · rfl
    · obtain ⟨u, v, huv, hu, hv⟩ := (c99_gF G _).mp h
      simp only [PEqualNP.ReadK.setInput, decide_eq_true_eq] at hu hv
      exact absurd huv (hJ u hu v hv)
  have hFy : graphFun G ∅ (PEqualNP.ReadK.setInput (insert a J)) = true :=
    (c99_gF G _).mpr ⟨a, c, hac, by simp [PEqualNP.ReadK.setInput],
      by simp [PEqualNP.ReadK.setInput, hcJ]⟩
  have hout : val (⟨c99gs X n C.gates, C.output⟩ : Circuit)
      (List.ofFn (fun i : Fin n => decide (i = a ∧ i.val ≠ X))) C.output = false := by
    have e := c99_fold X C.gates (List.ofFn (fun i : Fin n => decide (i = a ∧ i.val ≠ X)))
    rw [e, List.length_ofFn] at hfold
    exact hfold
  have hneq : val C (List.ofFn (PEqualNP.ReadK.setInput J)) X ≠
      val C (List.ofFn (PEqualNP.ReadK.setInput (insert a J))) X := by
    intro heq
    have h1 : circuitFun n C (PEqualNP.ReadK.setInput J) = circuitFun n C (PEqualNP.ReadK.setInput (insert a J)) :=
      c99_key n C X a _ _ hRB hxy heq C.output hout
    rw [hfun, hFx, hFy] at h1
    cases h1
  have hmono := mono n C hAF.1 _ _ hle X
  refine ⟨?_, ?_⟩
  · show val C (List.ofFn (PEqualNP.ReadK.setInput J)) X = false
    cases h1 : val C (List.ofFn (PEqualNP.ReadK.setInput J)) X
    · rfl
    · exfalso
      exact hneq (by rw [h1, hmono h1])
  · show val C (List.ofFn (PEqualNP.ReadK.setInput (insert a J))) X = true
    cases h2 : val C (List.ofFn (PEqualNP.ReadK.setInput (insert a J))) X
    · exfalso
      apply hneq
      rw [h2]
      cases h1 : val C (List.ofFn (PEqualNP.ReadK.setInput J)) X
      · rfl
      · have := hmono h1
        rw [h2] at this
        cases this
    · rfl

end PEqualNP.Outside.L_meta_5399

theorem PEqualNP.Outside.L_meta_5399 : ∀ (n : ℕ) (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] (C : PEqualNP.CircuitLowerBounds.Circuit) (a c : Fin n) (X : ℕ), PEqualNP.ReadK.AndOrFanInTwo C → PEqualNP.MetaComplexity.NestedCover.ReadsBack n C → PEqualNP.MetaComplexity.circuitFun n C = PEqualNP.MetaComplexity.NestedCover.graphFun G ∅ → G.Adj a c → (C.gates.foldl (fun (d : List Bool) (g : PEqualNP.CircuitLowerBounds.Gate) => d ++ [decide (d.length ≠ X) && g.inputs.any fun i => d.getD i false]) (List.ofFn fun i : Fin n => decide (i = a ∧ i.val ≠ X))).getD C.output false = false → ∀ J : Finset (Fin n), (∀ u ∈ J, ∀ v ∈ J, ¬ G.Adj u v) → c ∈ J → PEqualNP.CleanedNonEdge.wireVal n C X (PEqualNP.ReadK.setInput J) = false ∧ PEqualNP.CleanedNonEdge.wireVal n C X (PEqualNP.ReadK.setInput (insert a J)) = true :=
  PEqualNP.Outside.L_meta_5399.main_aux
